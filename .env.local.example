# ============================================
# ConcursoTrack - Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in your actual values
#
# To create .env.local:
# cp .env.local.example .env.local
#
# ⚠️ IMPORTANT: Never commit .env.local to git!
# ============================================

# --------------------------------------------
# SUPABASE CONFIGURATION
# --------------------------------------------
# Get these values from: https://app.supabase.com
# Go to: Project Settings → API

# Project URL (looks like: https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Anon/Public Key (safe to expose in browser)
# This is a long string starting with "eyJ..."
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key_here

# --------------------------------------------
# PRISMA DATABASE CONFIGURATION (v7+)
# --------------------------------------------
# Get from: Supabase → Project Settings → Database → Connection string

# Use Transaction Pooler (Session Mode) for best performance
# Format: postgresql://postgres.xxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Note: Prisma v7 uses prisma.config.ts for configuration
# DIRECT_URL is no longer needed in .env

# --------------------------------------------
# APPLICATION CONFIGURATION
# --------------------------------------------

# Site URL (use localhost for development)
# For production, use your actual domain: https://concurso-track.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------
# OPTIONAL CONFIGURATION
# --------------------------------------------

# Service Role Key (KEEP SECRET! Only use server-side)
# Only needed if you implement admin features
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Direct Connection (for migrations/backups)
# Only needed if you use Prisma or direct database access
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# --------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES (Vercel)
# --------------------------------------------
# When deploying to Vercel, add these in:
# Vercel Dashboard → Project → Settings → Environment Variables
#
# Required:
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - NEXT_PUBLIC_SITE_URL (set to your production domain)
#
# Make sure to set them for:
# ✓ Production
# ✓ Preview
# ✓ Development
